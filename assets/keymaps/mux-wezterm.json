// §16.7 Mux wezterm keymap profile: wezterm-compatible Alt+key bindings
// spec §16.7, Plan 17 — wezterm-style Alt-prefix bindings
// Matches wezterm's default key assignment patterns
[
  {
    "context": "Terminal",
    "bindings": {
      // Native lifecycle controls remain available even if QuickJS fails.
      "ctrl-alt-a": "mux::Attach",
      "ctrl-alt-k": "mux::KillSession",
      "ctrl-alt-q": "mux::KillServer",
      // Tab management
      "alt-shift-t": "mux_pane::NewTab",
      "alt-shift-q": "mux_pane::CloseTab",
      "alt-shift-n": "mux_pane::NextTab",
      "alt-shift-p": "mux_pane::PrevTab",

      // Pane splitting (wezterm uses Alt+Shift+D for horizontal, Alt+Shift+K for vertical)
      "alt-shift-d": "mux_pane::SplitRight",
      "alt-shift-k": "mux_pane::SplitDown",

      // Pane navigation (wezterm directional)
      "alt-shift-left": "mux_pane::FocusLeft",
      "alt-shift-right": "mux_pane::FocusRight",
      "alt-shift-up": "mux_pane::FocusUp",
      "alt-shift-down": "mux_pane::FocusDown",

      // Pane navigation (wezterm hjkl)
      "alt-h": "mux_pane::FocusLeft",
      "alt-j": "mux_pane::FocusDown",
      "alt-k": "mux_pane::FocusUp",
      "alt-l": "mux_pane::FocusRight",

      // Pane switching by number (wezterm style)
      "alt-1": "mux_pane::FocusPane0",
      "alt-2": "mux_pane::FocusPane1",
      "alt-3": "mux_pane::FocusPane2",
      "alt-4": "mux_pane::FocusPane3",
      "alt-5": "mux_pane::FocusPane4",
      "alt-6": "mux_pane::FocusPane5",
      "alt-7": "mux_pane::FocusPane6",
      "alt-8": "mux_pane::FocusPane7",
      "alt-9": "mux_pane::FocusPane8",

      // Pane zoom
      "alt-z": "mux_pane::ZoomToggle",

      // Pane resizing (wezterm style)
      "alt-shift-left": "mux_pane::ResizeLeft",
      "alt-shift-right": "mux_pane::ResizeRight",
      "alt-shift-up": "mux_pane::ResizeUp",
      "alt-shift-down": "mux_pane::ResizeDown",

      // Mux session
      "ctrl-shift-d": "mux::Detach",

      // §12 复制模式 (Plan 31)
      "ctrl-shift-;": "terminal::EnterCopyMode"
    }
  }
]
