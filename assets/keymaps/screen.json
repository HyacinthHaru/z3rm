// §16.7 Mux screen keymap profile: prefix key (Ctrl-a) + prefix-mode bindings
// spec §16.7, Plan 17 — GNU screen-compatible subset (~80% of common operations)
// NOTE: This is NOT 1:1 screen compatibility; it covers the most common operations.
[
  // Normal mode: prefix key triggers prefix mode with 500ms timeout
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-a": ["mux::EnterPrefixMode", { "timeout_ms": 500 }],
      // §3.3 / §15.7 A GUI window has no screen prefix equivalent, so the second
      // window stays on a native prefix-free chord (Plan 32).
      "ctrl-alt-n": "mux::NewWindow",

      // §12 复制模式 (Plan 31)
      "ctrl-shift-;": "terminal::EnterCopyMode"
    }
  },
  // Prefix mode: after Ctrl-a, the next key is matched here
  {
    "context": "Terminal && PrefixMode",
    "bindings": {
      // Tab (window) management
      "c": "mux_pane::NewTab",
      "k": "mux_pane::CloseTab",
      "n": "mux_pane::NextTab",
      "p": "mux_pane::PrevTab",

      // Pane splitting
      "S": "mux_pane::SplitRight",
      "s": "mux_pane::SplitDown",

      // Pane navigation (directional)
      "left": "mux_pane::FocusLeft",
      "right": "mux_pane::FocusRight",
      "up": "mux_pane::FocusUp",
      "down": "mux_pane::FocusDown",
      "tab": "mux_pane::FocusNextPane",

      // Pane switching by number (0-8; FocusPane9 is not a registered action)
      "0": "mux_pane::FocusPane0",
      "1": "mux_pane::FocusPane1",
      "2": "mux_pane::FocusPane2",
      "3": "mux_pane::FocusPane3",
      "4": "mux_pane::FocusPane4",
      "5": "mux_pane::FocusPane5",
      "6": "mux_pane::FocusPane6",
      "7": "mux_pane::FocusPane7",
      "8": "mux_pane::FocusPane8",

      // Pane zoom (fullscreen toggle)
      "F": "mux_pane::ZoomToggle",

      // Mux session
      "d": "mux::Detach",
      // §15.4 手动重连当前窗口的连接
      "r": "mux::Reconnect",

      // Send literal Ctrl-a to PTY (double-tap escape)
      "ctrl-a": ["terminal::SendLiteral", { "keystroke": "Ctrl-a" }]
    }
  }
]
