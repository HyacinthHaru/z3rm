---
import Z3rmWasmDemo from "./Z3rmWasmDemo.astro";
type Props = { lang: "en" | "zh" };
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}/${lang}/${path}`;
const media = (name: string) => `${base}/media/${name}`;
const copy = lang === "zh" ? {
  eyebrow: "GPU 终端 · 持久会话 · Agent 控制",
  title: "你的 Shell，不随窗口消失。",
  lead: "Z3rm 把终端渲染、tmux 级多路复用、远程连接和可审计的文件快照放进同一个工作空间。",
  start: "5 分钟开始", guides: "阅读指南", install: "cargo install z3rm",
  copy: "复制", copyInstall: "复制安装命令", copied: "已复制",
  verified: "经实现与回归测试验证", server: "服务端权威", reconnect: "随处重连", protocol: "人和 Agent 共用协议",
  thesisKicker: "不是又一个终端皮肤", thesis: "窗口只是视图。会话才是工作。",
  thesisBody: "PTY、网格、滚动历史、布局和生命周期都由 mux server 持有。关闭 GUI、切换机器或通过 SSH 接入时，状态不会被重新解释。",
  architecture: "一条数据路径", architectureBody: "GUI、CLI 与远程客户端通过同一套有帧二进制协议读取结构化状态。客户端不解析 PTY 字节，也不拥有布局权。",
  lifecycle: "先离开，再回来", lifecycleBody: "detach 只关闭视图。服务端继续运行进程；本机和远程 attach 都从权威快照恢复。",
  surfaces: "真实渲染证据", surfacesBody: "这些画面来自 Z3rm 自己的 GPUI 无头渲染回归，不是营销稿或浏览器仿制。",
  terminal: "结构化终端网格", chrome: "QuickJS 扩展状态栏", snapshot: "影子快照", snapshotBody: "独立于 Git 的细粒度版本链，使用 WAL、单调序号和有界 delta；拒绝或撤销前先持久化恢复意图。",
  forHumans: "给人类", forHumansBody: "键盘优先的窗格、滚动历史、搜索、分离与重连。", forAgents: "给 Agent", forAgentsBody: "显式目标、稳定格式和可观察的会话控制。",
  inspect: "查看完整实现状态", auditCount: "12 项已验证 · 1 项实验性", final: "从一个不会消失的会话开始。", finalBody: "先用 CLI 建立工作区，再按需要打开 GPU 界面或从远程接入。"
} : {
  eyebrow: "GPU terminal · persistent sessions · agent control",
  title: "Your shells outlive the window.",
  lead: "Z3rm puts GPU terminal rendering, tmux-class multiplexing, remote access, and auditable file snapshots in one workspace.",
  start: "Start in 5 minutes", guides: "Read the guides", install: "cargo install z3rm",
  copy: "Copy", copyInstall: "Copy install command", copied: "Copied",
  verified: "Verified in implementation and regression tests", server: "Server authoritative", reconnect: "Reconnect anywhere", protocol: "One protocol for humans and agents",
  thesisKicker: "Not another terminal skin", thesis: "The window is a view. The session is the work.",
  thesisBody: "PTYs, grids, scrollback, layout, and lifecycle live in the mux server. Close the GUI, change machines, or arrive over SSH without asking a client to reinterpret state.",
  architecture: "One data path", architectureBody: "GUI, CLI, and remote clients read structured state through the same framed binary protocol. Clients do not parse PTY bytes or own layout authority.",
  lifecycle: "Leave. Then come back.", lifecycleBody: "Detach closes a view, not a process. Local and remote attach reconcile from an authoritative snapshot while the server keeps the session alive.",
  surfaces: "Evidence from the real renderer", surfacesBody: "These frames come from Z3rm's own GPUI headless regression harness—not a marketing mock or a terminal recreated in the browser.",
  terminal: "Structured terminal grid", chrome: "QuickJS extension status bar", snapshot: "Shadow snapshots", snapshotBody: "Fine-grained history independent of Git, with a WAL, monotonic sequence numbers, and bounded deltas. Restore intent is durable before files change.",
  forHumans: "For humans", forHumansBody: "Keyboard-first panes, scrollback, search, detach, and reconnect.", forAgents: "For agents", forAgentsBody: "Explicit targets, stable formats, and observable session control.",
  inspect: "Inspect the full implementation status", auditCount: "12 verified · 1 experimental", final: "Start with a session that stays.", finalBody: "Create the workspace from the CLI, then open the GPU view or attach remotely when you need it."
};
---
<main id="content" class="landing">
  <section class="hero section-shell">
    <div class="hero-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="hero-actions">
        <a class="primary-action" href={href("quick-start/")}>{copy.start}</a>
        <a class="text-action" href={href("guide/for-humans/")}>{copy.guides} <span aria-hidden="true">→</span></a>
      </div>
      <div class="install-snippet">
        <code class="install-command" data-install-command>$ {copy.install}</code>
        <button type="button" class="copy-install" data-copy-install aria-label={copy.copyInstall ?? "Copy install command"}>
          <span data-copy-label>{copy.copy ?? "Copy"}</span>
        </button>
        <span class="copy-confirm" data-copy-confirm role="status" aria-live="polite"></span>
      </div>
    </div>
    <figure class="terminal-frame">
      <div class="frame-bar"><span></span><span></span><span></span><small>z3rm · work:1</small></div>
      <img src={media("z3rm-terminal-grid.png")} alt={copy.terminal} width="1440" height="800" />
      <figcaption><span class="live-dot"></span>{copy.verified}</figcaption>
    </figure>
  </section>

  <div class="proof-strip section-shell" aria-label={copy.verified}>
    <span><b>01</b>{copy.server}</span><span><b>02</b>{copy.reconnect}</span><span><b>03</b>{copy.protocol}</span>
  </div>

  <section class="thesis section-shell">
    <p class="section-index">01 / MODEL</p><div><p class="eyebrow">{copy.thesisKicker}</p><h2>{copy.thesis}</h2><p>{copy.thesisBody}</p></div>
  </section>

  <section class="visual-section section-shell">
    <div class="section-heading"><p class="section-index">02 / ARCHITECTURE</p><div><h2>{copy.architecture}</h2><p>{copy.architectureBody}</p></div><a href={href("concepts/server-canonical-model/")}>Z3RM-MUX-001 ↗</a></div>
    <figure class="diagram"><img src={media("server-canonical-architecture.svg")} alt={copy.architecture} width="1200" height="560" /></figure>
  </section>

  <section class="visual-section section-shell lifecycle-section">
    <div class="section-heading"><p class="section-index">03 / LIFECYCLE</p><div><h2>{copy.lifecycle}</h2><p>{copy.lifecycleBody}</p></div><a href={href("concepts/sessions-and-panes/")}>Z3RM-RECONNECT-001 ↗</a></div>
    <figure class="diagram"><img src={media("session-lifecycle.svg")} alt={copy.lifecycle} width="1200" height="430" /></figure>
  </section>

  <Z3rmWasmDemo lang={lang} />

  <section class="evidence section-shell">
    <div class="section-heading"><p class="section-index">05 / RENDERER</p><div><h2>{copy.surfaces}</h2><p>{copy.surfacesBody}</p></div></div>
    <div class="evidence-grid">
      <figure><img src={media("z3rm-terminal-grid.png")} alt={copy.terminal} width="1440" height="800" /><figcaption><b>{copy.terminal}</b><code>ui_screenshot_regression</code></figcaption></figure>
      <figure class="chrome-capture"><img src={media("z3rm-extension-status-bar.png")} alt={copy.chrome} width="1120" height="160" /><figcaption><b>{copy.chrome}</b><code>Z3RM-EXT-001</code></figcaption></figure>
    </div>
  </section>

  <section class="snapshot section-shell">
    <div><p class="section-index">06 / RECOVERY</p><h2>{copy.snapshot}</h2><p>{copy.snapshotBody}</p><a class="text-action" href={href("concepts/shadow-snapshots/")}>Z3RM-SNAPSHOT-001 <span aria-hidden="true">→</span></a></div>
    <div class="wal-visual" aria-hidden="true"><span>SEQ 1048</span><i></i><span>WAL FSYNC</span><i></i><span>RESTORE</span><i></i><span>FILE</span></div>
  </section>

  <section class="audiences section-shell">
    <a href={href("guide/for-humans/")}><span>H</span><div><h3>{copy.forHumans}</h3><p>{copy.forHumansBody}</p></div><b>↗</b></a>
    <a href={href("guide/for-agents/")}><span>A</span><div><h3>{copy.forAgents}</h3><p>{copy.forAgentsBody}</p></div><b>↗</b></a>
  </section>

  <section class="status-link section-shell"><a href={href("implementation-status/")}><span>{copy.inspect}</span><b>{copy.auditCount}</b><i aria-hidden="true">→</i></a></section>

  <section class="final-cta section-shell"><p class="section-index">07 / START</p><h2>{copy.final}</h2><p>{copy.finalBody}</p><a class="primary-action" href={href("quick-start/")}>{copy.start}</a></section>
</main>

<script>
  // One-tap copy for the primary install command. The confirm message is a
  // polite live region so screen readers hear the result of the action.
  const installButton = document.querySelector<HTMLButtonElement>("[data-copy-install]");
  const installCommand = document.querySelector<HTMLElement>("[data-install-command]");
  const confirm = document.querySelector<HTMLElement>("[data-copy-confirm]");
  const copyLabel = document.querySelector<HTMLElement>("[data-copy-label]");
  if (installButton && installCommand) {
    installButton.addEventListener("click", async () => {
      const text = installCommand.textContent?.replace(/^\$\s*/, "").trim() ?? "";
      (window as unknown as { __z3rmCopied?: string }).__z3rmCopied = text;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const area = document.createElement("textarea");
        area.value = text;
        area.setAttribute("readonly", "");
        area.style.position = "fixed";
        area.style.opacity = "0";
        document.body.append(area);
        area.select();
        try {
          document.execCommand("copy");
        } catch {
          // Clipboard unavailable (permissions/no focus): the confirmation
          // simply won't appear; nothing to clean up beyond the helper.
        }
        area.remove();
      }
      // The resting label is captured up-front so a rapid second click
      // (mid-confirmation) cannot capture "Copied" as its own rest state.
      if (!installButton.dataset.restLabel && copyLabel) {
        installButton.dataset.restLabel = copyLabel.textContent ?? "";
      }
      const done = copyLabel?.dataset.done ?? "Copied";
      const rest = installButton.dataset.restLabel ?? "Copy";
      if (copyLabel) copyLabel.textContent = done;
      if (confirm) confirm.textContent = done;
      window.clearTimeout(Number(installButton.dataset.resetTimer));
      installButton.dataset.resetTimer = String(
        window.setTimeout(() => {
          if (copyLabel) copyLabel.textContent = rest;
          if (confirm) confirm.textContent = "";
          delete installButton.dataset.resetTimer;
        }, 1600),
      );
    });
  }
</script>

<style>
  .landing { overflow: hidden; }
  .section-shell { width: min(calc(100% - 2rem), var(--page-width)); margin-inline: auto; }
  .hero { min-height: 650px; display: grid; grid-template-columns: .85fr 1.15fr; align-items: center; gap: clamp(2rem, 5vw, 5.5rem); padding-block: var(--section-gap); }
  .eyebrow,.section-index { color: var(--accent-blue); font: 600 .68rem/1.4 var(--font-mono); letter-spacing: .13em; text-transform: uppercase; }
  h1 { max-width: 12ch; margin: .8rem 0 1.4rem; font: 560 clamp(3rem, 5.2vw, 5.4rem)/.94 var(--font-sans); letter-spacing: -.065em; }
  .lead { max-width: 40rem; color: var(--text-secondary); font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 1.65; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; margin-top: 2rem; }
  .primary-action { display: inline-flex; min-height: 2.8rem; align-items: center; padding: 0 1.15rem; color: #fff; background: #2d5c94; text-decoration: none; font-size: .84rem; font-weight: 650; }
  .primary-action:hover { background: #24496f; }
  :global([data-theme="dark"]) .primary-action { color: #10141a; background: var(--accent-blue); }
  :global([data-theme="dark"]) .primary-action:hover { background: #93b7de; }
  .text-action { color: var(--text-primary); text-decoration: none; font-size: .86rem; font-weight: 600; }
  .install-command { display: inline-block; margin-top: 1.6rem; color: var(--text-muted); font-size: .76rem; }
  .install-snippet { display: flex; align-items: center; gap: .6rem; margin-top: 1.6rem; }
  .install-snippet .install-command { margin-top: 0; }
  .copy-install { min-height: 2rem; padding: .3rem .7rem; border: 1px solid var(--border-muted); border-radius: var(--radius-control); color: var(--text-primary); background: var(--surface-panel); cursor: pointer; font: 600 .72rem/1 var(--font-mono); }
  .copy-install:hover { background: var(--surface-hover); }
  .copy-install:active, .copy-install:hover:active { background: var(--surface-selected); }
  .copy-confirm { color: var(--accent-green); font: 600 .72rem/1 var(--font-mono); }
  .copy-confirm:empty { display: none; }
  .terminal-frame { margin: 0; overflow: hidden; border: 1px solid var(--border-strong); background: #0d1117; box-shadow: var(--shadow-window); transform: perspective(1300px) rotateY(-2deg); }
  .frame-bar { height: 2.2rem; display: flex; align-items: center; gap: .4rem; padding: 0 .8rem; border-bottom: 1px solid #28303b; background: #171c24; }
  .frame-bar span { width: .52rem; height: .52rem; border: 1px solid #566172; border-radius: 50%; }
  .frame-bar small { margin-left: auto; color: #8792a2; font: .65rem var(--font-mono); }
  .terminal-frame img { display: block; width: 100%; height: auto; }
  .terminal-frame figcaption { display: flex; align-items: center; gap: .5rem; padding: .75rem .9rem; color: #9ca7b5; font: .66rem var(--font-mono); }
  .live-dot { width: .45rem; height: .45rem; border-radius: 50%; background: var(--accent-green); box-shadow: 0 0 0 4px rgb(70 166 92 / 12%); }
  .proof-strip { display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid var(--border-muted); }
  .proof-strip span { display: flex; gap: 1rem; padding: 1.25rem; color: var(--text-secondary); font-size: .75rem; }
  .proof-strip span + span { border-left: 1px solid var(--border-muted); }
  .proof-strip b { color: var(--accent-blue); font: .65rem var(--font-mono); }
  .thesis { display: grid; grid-template-columns: minmax(7rem,.35fr) 1fr; gap: 2rem; padding-block: var(--section-gap); }
  .thesis h2,.section-heading h2,.snapshot h2,.final-cta h2 { margin: .5rem 0 1rem; font-size: clamp(2.2rem, 4.5vw, 4.6rem); line-height: 1; letter-spacing: -.055em; }
  .thesis > div { max-width: 830px; }.thesis > div > p:last-child,.section-heading div p,.snapshot p,.final-cta > p:not(.section-index) { max-width: 660px; color: var(--text-secondary); font-size: 1rem; line-height: 1.75; }
  .visual-section,.evidence { padding-block: var(--section-gap-tight); border-top: 1px solid var(--border-muted); }
  .section-heading { display: grid; grid-template-columns: minmax(7rem,.35fr) 1fr auto; gap: 2rem; align-items: end; margin-bottom: 3rem; }
  .section-heading h2 { font-size: clamp(2rem, 3.5vw, 3.7rem); }.section-heading p { margin-bottom: 0; }
  .section-heading > a { color: var(--text-muted); font: .67rem var(--font-mono); text-decoration: none; }
  .diagram { margin: 0; border: 1px solid var(--border-muted); background: #0d1117; }.diagram img { display: block; width: 100%; height: auto; }
  .lifecycle-section { padding-top: 7rem; }
  .evidence-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 1.25rem; align-items: stretch; }
  .evidence-grid figure { margin: 0; border: 1px solid var(--border-muted); background: #0d1117; display: flex; flex-direction: column; justify-content: space-between; }
  .evidence-grid img { display: block; width: 100%; height: auto; }.chrome-capture img { margin-block: auto; }
  .evidence-grid figcaption { display: flex; justify-content: space-between; gap: 1rem; padding: .9rem; border-top: 1px solid #29313c; color: #dce1e7; font-size: .75rem; }.evidence-grid figcaption code { color: #8792a2; }
  .snapshot { display: grid; grid-template-columns: .9fr 1.1fr; gap: 5rem; align-items: center; padding-block: var(--section-gap); border-top: 1px solid var(--border-muted); }
  .wal-visual { display: flex; align-items: center; min-height: 230px; padding: 2rem; background: #0d1117; border: 1px solid var(--border-muted); }
  .wal-visual span { color: #dce1e7; font: .7rem var(--font-mono); white-space: nowrap; }.wal-visual i { flex: 1; height: 1px; margin: 0 .8rem; background: #2a78d4; position: relative; }.wal-visual i::after { content:""; position:absolute; right:0; top:-3px; width:7px; height:7px; border-top:1px solid #2a78d4; border-right:1px solid #2a78d4; transform:rotate(45deg); }
  .audiences { display: grid; grid-template-columns: 1fr 1fr; border-block: 1px solid var(--border-muted); }
  .audiences > a { display: grid; grid-template-columns: auto 1fr auto; gap: 1.3rem; align-items: center; padding: 2.2rem; color: inherit; text-decoration: none; }.audiences > a + a { border-left: 1px solid var(--border-muted); }.audiences > a:hover { background: var(--surface-hover); }
  .audiences > a > span { color: var(--accent-blue); font: 1.2rem var(--font-mono); }.audiences h3 { margin: 0 0 .35rem; }.audiences p { margin: 0; color: var(--text-secondary); font-size: .8rem; }
  .status-link { padding-block: 2rem; }.status-link a { display: grid; grid-template-columns: 1fr auto auto; gap: 2rem; padding: 1.4rem 1.6rem; border: 1px solid var(--border-muted); color: inherit; text-decoration: none; }.status-link b { color: var(--accent-green); font: .7rem var(--font-mono); }
  .final-cta { max-width: 820px; text-align: center; padding-block: var(--section-gap); }.final-cta .section-index { color: var(--text-muted); }.final-cta h2 { margin-inline: auto; }.final-cta > p:not(.section-index) { margin: 0 auto 2rem; }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; padding-top: 4rem; }.terminal-frame { transform: none; }.section-heading { grid-template-columns: 1fr; }.evidence-grid,.snapshot { grid-template-columns: 1fr; }.snapshot { gap: 2.5rem; }.section-heading > a { justify-self: start; } }
  @media (max-width: 620px) { .proof-strip { grid-template-columns: 1fr; }.proof-strip span + span { border-left: 0; border-top: 1px solid var(--border-muted); }.thesis { grid-template-columns: 1fr; padding-block: var(--section-gap-tight); }.audiences { grid-template-columns: 1fr; }.audiences > a + a { border-left: 0; border-top: 1px solid var(--border-muted); }.status-link a { grid-template-columns: 1fr auto; }.status-link b { grid-column: 1; grid-row: 2; }.wal-visual { overflow-x: auto; }.hero { min-height: 0; }.evidence-grid figcaption { flex-direction: column; } }
</style>
