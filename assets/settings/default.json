{
  // z3rm 默认设置
  // 终端/多路复用器/UI chrome 设置

  // === 项目设置 (ProjectSettingsContent - flattened) ===
  "excluded_paths": ["node_modules", ".git"],
  "scan_symlinks": "local_only",
  // Files whose contents must never leave the machine.
  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/*.cert",
    "**/*.crt",
    "**/secrets.yml"
  ],
  "hidden_files": [],
  "read_only_files": [],
  "file_scan_inclusions": [".env*"],

  "all_languages": {
    "defaults": {
      "word_diff_enabled": true
    }
  },

  // === 扩展设置 (ExtensionSettingsContent) ===
  "extension": {
    "directory": "~/.config/z3rm/extensions",
    "auto_sync_to_remote": true,
    "auto_install_extensions": {},
    "auto_update_extensions": {},
    "granted_capabilities": [
      {
        "kind": "process:exec",
        "command": "*",
        "args": ["**"]
      },
      {
        "kind": "download_file",
        "host": "*",
        "path": ["**"]
      },
      {
        "kind": "npm:install",
        "package": "*"
      }
    ]
  },

  // === 工作区设置 (WorkspaceSettingsContent - flattened) ===
  "window_decorations": "client",
  "text_rendering_mode": "platform_default",
  "focus_follows_mouse": { "enabled": false },
  "confirm_quit": false,
  "on_last_window_closed": "nothing",

  // === 远程设置 (RemoteSettingsContent - flattened) ===
  "auto_install": true,

  // === Tab 栏设置 ===
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
    "show_tab_bar_buttons": true,
    "show_pinned_tabs_in_separate_row": false,
    "middle_click_to_close": true,
    "mouse_scroll_to_switch": true,
    "show_active_item": false,
    "show_close_button": "hover"
  },

  // === 单个 Tab 项设置 ===
  "tabs": {
    "git_status": true,
    "close_position": "right",
    "activate_on_close": "next",
    "file_icons": true,
    "show_diagnostics": "off",
    "show_close_button": "hover"
  },

  // === 预览 Tab 设置 ===
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_project_panel": true,
    "enable_preview_from_file_finder": true,
    "enable_preview_from_multibuffer": true,
    "enable_preview_multibuffer_from_code_navigation": true,
    "enable_preview_file_from_code_navigation": true,
    "enable_keep_preview_on_code_navigation": false
  },

  // === Which-key 弹窗设置 ===
  "which_key": {
    "enabled": false,
    "delay_ms": 1000
  },

  // === 标题栏设置 ===
  "title_bar": {
    "show_branch_status_icon": false,
    "show_onboarding_banner": true,
    "show_user_picture": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_sign_in": true,
    "show_user_menu": true
  },

  // === 状态栏设置 ===
  "status_bar": {
    "stack_size": false,
    "working_directory": true,
    "session_status": false,
    "active_language_button": true,
    "active_encoding_button": "non_utf8",
    "cursor_position_button": true,
    "line_endings_button": false
  },

  // === 编辑器与搜索设置 ===
  "editor": {
    "cursor_blink": true,
    "cursor_shape": null,
    "current_line_highlight": "line",
    "selection_highlight": true,
    "rounded_selection": true,
    "lsp_highlight_debounce": 100,
    "hover_popover_enabled": true,
    "hover_popover_delay": 50,
    "hover_popover_sticky": true,
    "hover_popover_hiding_delay": 100,
    "toolbar": {
      "breadcrumbs": true,
      "quick_actions": true,
      "selections_menu": true,
      "agent_review": true,
      "code_actions": true
    },
    "scrollbar": {
      "show": "auto",
      "git_diff": true,
      "search_results": true,
      "selected_text": true,
      "selected_symbol": true,
      "diagnostics": "none",
      "cursors": true,
      "axes": {
        "horizontal": true,
        "vertical": true
      }
    },
    "minimap": {
      "show": "auto",
      "display_in": "active_editor",
      "thumb": "always",
      "thumb_border": "full",
      "current_line_highlight": null,
      "max_width_columns": 128
    },
    "gutter": {
      "min_line_number_digits": 2,
      "line_numbers": true,
      "runnables": true,
      "breakpoints": true,
      "bookmarks": true,
      "folds": true
    },
    "scroll_beyond_last_line": "one_page",
    "vertical_scroll_margin": 0.0,
    "autoscroll_on_clicks": true,
    "horizontal_scroll_margin": 0.0,
    "scroll_sensitivity": 1.0,
    "mouse_wheel_zoom": false,
    "fast_scroll_sensitivity": 2.0,
    "sticky_scroll": {
      "enabled": false
    },
    "relative_line_numbers": "disabled",
    "seed_search_query_from_cursor": "none",
    "use_smartcase_search": true,
    "multi_cursor_modifier": "alt",
    "redact_private_values": false,
    "expand_excerpt_lines": 3,
    "excerpt_context_lines": 3,
    "middle_click_paste": false,
    "double_click_in_multibuffer": "select",
    "search_wrap": true,
    "search": {
      "button": true,
      "whole_word": false,
      "case_sensitive": false,
      "include_ignored": false,
      "regex": false,
      "center_on_match": true
    },
    "auto_signature_help": true,
    "show_signature_help_after_edits": false,
    "go_to_definition_fallback": "lens",
    "go_to_definition_scroll_strategy": "center",
    "jupyter": {
      "enabled": true
    },
    "snippet_sort_order": "relevance",
    "diagnostics_max_severity": null,
    "inline_code_actions": false,
    "drag_and_drop_selection": {
      "enabled": true,
      "delay": 300
    },
    "code_lens": "on",
    "lsp_document_colors": "inlay",
    "lsp_document_links": true,
    "minimum_contrast_for_highlights": 0.15,
    "completion_menu_scrollbar": "auto",
    "completion_detail_alignment": "left",
    "completion_menu_item_kind": "all",
    "diff_view_style": "unified",
    "minimum_split_diff_width": 480.0
  },

  // === 终端设置 ===
  "terminal": {
    "shell": "system",
    "working_directory": "current_project_directory",
    "env": {},
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default",
        "conda_manager": "auto"
      }
    },
    "font_weight": 400,
    "line_height": "standard",
    "cursor_shape": "block",
    "blinking": "terminal_controlled",
    "alternate_scroll": "on",
    "option_as_meta": false,
    "copy_on_select": false,
    "keep_selection_on_copy": true,
    "open_links_in_mouse_mode": true,
    "button": true,
    "dock": "bottom",
    "flexible": true,
    "default_width": 640,
    "default_height": 320,
    "max_scroll_history_lines": 10000,
    "scroll_multiplier": 1.0,
    "toolbar": {
      "breadcrumbs": false
    },
    "scrollbar": {
      "show": null
    },
    "minimum_contrast": 45,
    "path_hyperlink_regexes": [
      "File \"(?<path>[^\"]+)\", line (?<line>[0-9]+)",
      [
        "(?x)",
        "(?<path>",
        "    (",
        "        [^({\\[<\"'`\\ \\u2500-\\u257F]",
        "        ([^\\ :(]|[:(][^0-9()\\ ])*",
        "        [^()}\\]>\"'`.,;:\\ ]",
        "    |",
        "        [^(){}\\[\\]<>\"'`.,;:\\ \\u2500-\\u257F]",
        "    )",
        "    (:+[0-9]+(:[0-9]+)?|:?\\([0-9]+([,:]?[0-9]+)?\\))?",
        ")"
      ]
    ],
    "path_hyperlink_timeout_ms": 1,
    "show_count_badge": false,
    "bell": "off"
  },

  // === 多路复用器设置 ===
  "mux": {
    "keep_alive": true,
    "tabbar_style": "top",
    "scroll_mode": "per_client"
  },

  // === 影子快照设置 ===
  "shadow_snapshot": {
    "enabled": true,
    "quota_mode": "per_project",
    "per_project_quota_mb": 500,
    "ignore_patterns": [],
    "binary_detection": true,
    "debounce_ms": 500,
    "frequency_circuit_breaker_k": 10,
    "git_commit_hook": "clear"
  },

  // === 鼠标隐藏模式 ===
  "hide_mouse": "on_typing",

  // === Vim 模式 ===
  "vim_mode": false,

  // === 行号指示器格式 ===
  "line_indicator_format": "short"
}
