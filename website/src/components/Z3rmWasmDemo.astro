---
type Props = { lang: "en" | "zh" };
const { lang } = Astro.props;
const copy = lang === "zh" ? {
  eyebrow: "真实浏览器演示",
  title: "同一份 mux 快照，同一套 GPUI 投影",
  body: "下面不是 HTML 终端仿制品。它是编译为 WebAssembly 的 Z3rm GPUI 视图，直接使用 mux_protocol 会话结构和生产 layout_projection.rs。",
  session: "会话",
  contract: "数据契约",
  layout: "选择权威布局",
  current: "当前窗口",
  work: "工作区 · 左右分屏",
  observe: "监控 · 上下分屏",
  shell: "单窗格 Shell",
  reset: "重新加载 GPUI",
  details: "实现详情",
  detailTitle: "这段演示中真正运行的内容",
  detailBody: "Rust → wasm32-unknown-unknown；GPUI WebPlatform 单线程渲染；mux_protocol::SessionSnapshot 驱动 tab/pane；workspace/layout_projection.rs 计算每个 pane 的边界。",
  close: "关闭",
  contractBody: "GUI 不推断布局。每个 mux window 对应一个 tab，每个 pane leaf 对应一个 GPUI pane；切换 tab 或点击 RECONNECT 时，完整 SessionSnapshot 被重新投影。",
} : {
  eyebrow: "Live browser demo",
  title: "One mux snapshot. One GPUI projection.",
  body: "This is not an HTML terminal imitation. It is a Z3rm GPUI view compiled to WebAssembly, using mux_protocol session types and the production layout_projection.rs.",
  session: "Session",
  contract: "Data contract",
  layout: "Authoritative layout",
  current: "Current window",
  work: "work · left/right split",
  observe: "observe · top/bottom split",
  shell: "shell · single pane",
  reset: "Reload GPUI",
  details: "Implementation details",
  detailTitle: "What is actually running",
  detailBody: "Rust → wasm32-unknown-unknown; GPUI WebPlatform renders on one browser thread; mux_protocol::SessionSnapshot drives tabs and panes; workspace/layout_projection.rs computes every pane bound.",
  close: "Close",
  contractBody: "The GUI does not infer layout. Every mux window maps to one tab and every pane leaf to one GPUI pane. Tab changes and RECONNECT replace and re-project a complete SessionSnapshot.",
};
---

<section class="wasm-demo section-shell visual-section" id="live-gpui" data-z3rm-wasm-demo>
  <div class="demo-heading section-heading">
    <p class="section-index">04 / {copy.eyebrow}</p>
    <div>
      <h2>{copy.title}</h2>
      <p>{copy.body}</p>
    </div>
  </div>

  <proto-ui-base-tabs-root class="demo-tabs">
    <proto-ui-base-tabs-list class="demo-tabs-list">
      <proto-ui-base-tabs-trigger class="demo-tabs-trigger" data-value="session">{copy.session}</proto-ui-base-tabs-trigger>
      <proto-ui-base-tabs-trigger class="demo-tabs-trigger" data-value="contract">{copy.contract}</proto-ui-base-tabs-trigger>
    </proto-ui-base-tabs-list>
    <proto-ui-base-tabs-content data-value="session" class="demo-tab-panel">
      <div class="demo-controls">
        <label>
          <span>{copy.layout}</span>
          <proto-ui-base-select-root class="demo-select">
            <proto-ui-base-select-trigger data-a11y-label={copy.layout}><proto-ui-base-select-value></proto-ui-base-select-value></proto-ui-base-select-trigger>
            <proto-ui-base-select-content>
              <proto-ui-base-select-item data-value="window-0">{copy.work}</proto-ui-base-select-item>
              <proto-ui-base-select-item data-value="window-1">{copy.observe}</proto-ui-base-select-item>
              <proto-ui-base-select-item data-value="window-2">{copy.shell}</proto-ui-base-select-item>
            </proto-ui-base-select-content>
          </proto-ui-base-select-root>
        </label>
        <div class="demo-actions">
          <proto-ui-base-button data-action="reload">{copy.reset}</proto-ui-base-button>
          <proto-ui-base-dialog-root>
            <proto-ui-base-dialog-trigger>{copy.details}</proto-ui-base-dialog-trigger>
            <proto-ui-base-dialog-mask></proto-ui-base-dialog-mask>
            <proto-ui-base-dialog-content class="demo-dialog">
              <proto-ui-base-dialog-title>{copy.detailTitle}</proto-ui-base-dialog-title>
              <proto-ui-base-dialog-description>{copy.detailBody}</proto-ui-base-dialog-description>
              <proto-ui-base-dialog-close>{copy.close}</proto-ui-base-dialog-close>
            </proto-ui-base-dialog-content>
          </proto-ui-base-dialog-root>
        </div>
      </div>
      <div class="gpui-frame">
        <div class="frame-bar"><span></span><span></span><span></span><b>z3rm://session/work</b></div>
        <iframe title="Z3rm GPUI WebAssembly session projection" src={`${import.meta.env.BASE_URL}gpui-demo/index.html`} loading="lazy"></iframe>
      </div>
    </proto-ui-base-tabs-content>
    <proto-ui-base-tabs-content data-value="contract" class="demo-tab-panel contract-panel">
      <p class="section-index">SERVER → PROTOCOL → GPUI</p>
      <pre><code>SessionSnapshot {`{`} tabs, layout, focused_tab_id, focused_pane_id {`}`}
LayoutTree → LayoutProjection&lt;Bounds&lt;Pixels&gt;&gt;
PaneDirty(pane_id) → fetch_grid_update(generation)</code></pre>
    </proto-ui-base-tabs-content>
  </proto-ui-base-tabs-root>

</section>

<script>
  import { setElementProps } from "@proto.ui/adapter-web-component";

  for (const section of document.querySelectorAll<HTMLElement>("[data-z3rm-wasm-demo]")) {
    if (section.dataset.ready === "true") continue;
    section.dataset.ready = "true";

    const tabsRoot = section.querySelector<HTMLElement>("proto-ui-base-tabs-root");
    if (tabsRoot) setElementProps(tabsRoot, { defaultValue: "session", orientation: "horizontal" });
    for (const trigger of section.querySelectorAll<HTMLElement>("proto-ui-base-tabs-trigger")) {
      setElementProps(trigger, { value: trigger.dataset.value ?? "" });
    }
    for (const panel of section.querySelectorAll<HTMLElement>("proto-ui-base-tabs-content")) {
      setElementProps(panel, { value: panel.dataset.value ?? "", keepMounted: true });
    }

    const selectRoot = section.querySelector<HTMLElement>("proto-ui-base-select-root");
    if (selectRoot) setElementProps(selectRoot, { defaultValue: "window-0", closeOnSelect: true });
    const selectValue = section.querySelector<HTMLElement>("proto-ui-base-select-value");
    const selectTrigger = section.querySelector<HTMLElement>("proto-ui-base-select-trigger");
    if (selectTrigger) {
      setElementProps(selectTrigger, { a11yLabel: selectTrigger.dataset.a11yLabel });
    }
    if (selectValue) setElementProps(selectValue, { placeholder: "Current window" });
    for (const item of section.querySelectorAll<HTMLElement>("proto-ui-base-select-item")) {
      setElementProps(item, { value: item.dataset.value, textValue: item.textContent?.trim() });
    }

    const dialogRoot = section.querySelector<HTMLElement>("proto-ui-base-dialog-root");
    if (dialogRoot) setElementProps(dialogRoot, { defaultOpen: false, a11yLabel: "GPUI demo implementation details" });
    for (const transition of section.querySelectorAll<HTMLElement>("proto-ui-base-dialog-mask, proto-ui-base-dialog-content")) {
      setElementProps(transition, { duration: 120 });
    }

    const iframe = section.querySelector<HTMLIFrameElement>("iframe");
    section.querySelector<HTMLElement>("[data-action='reload']")?.addEventListener("click", () => {
      iframe?.contentWindow?.location.reload();
    });
    selectRoot?.addEventListener("valueChange", (event) => {
      const value = (event as CustomEvent<{ value?: string }>).detail?.value;
      if (!iframe || !value) return;
      const source = new URL(iframe.src);
      source.searchParams.set("window", value);
      iframe.src = source.toString();
    });

    // WAI-ARIA dialog pattern: on close, focus returns to the element that
    // opened it, so keyboard users are not teleported to the page top.
    let dialogOpener: HTMLElement | null = null;
    dialogRoot?.addEventListener("openChange", (event) => {
      const open = (event as CustomEvent<{ open?: boolean }>).detail?.open;
      if (open) {
        const trigger = section.querySelector<HTMLElement>("proto-ui-base-dialog-trigger");
        dialogOpener =
          document.activeElement instanceof HTMLElement && section.contains(document.activeElement)
            ? document.activeElement
            : trigger;
      } else if (dialogOpener) {
        // The base prototype restores focus into its (now hidden) content
        // after the close transition; re-assert after that settles.
        const opener = dialogOpener;
        dialogOpener = null;
        window.setTimeout(() => {
          if (!section.contains(document.activeElement) || document.querySelector(".demo-dialog")?.contains(document.activeElement)) {
            opener.focus();
          }
        }, 160);
      }
    });

  }
</script>

<style>
  .wasm-demo { padding-block: var(--section-gap-tight); border-top: 1px solid var(--border-muted); }
  /* Astro scoping keeps HomeLanding's .section-index/.section-heading rules
     from reaching this component, so mirror the editorial micro-label and
     grid here. */
  .demo-heading.section-heading { display: grid; grid-template-columns: minmax(7rem,.35fr) 1fr; gap: 2rem; align-items: end; margin-bottom: 3rem; }
  .demo-heading.section-heading p { margin-bottom: 0; }
  .section-index { color: var(--accent-blue); font: 600 .68rem/1.4 var(--font-mono); letter-spacing: .13em; text-transform: uppercase; }
  .section-heading p { margin-bottom: 0; }
  .contract-panel > p.section-index { color: var(--accent-blue); font: 600 .68rem/1.4 var(--font-mono); letter-spacing: .13em; text-transform: uppercase; margin-bottom: 0; }
  .demo-heading h2 { font-size: clamp(1.8rem, 3.6vw, 3.4rem); line-height: .98; letter-spacing: -.045em; margin: .6rem 0 1rem; }
  .demo-heading > div > p:last-child { color: var(--text-secondary); max-width: 68ch; margin-bottom: 0; }
  @media (max-width: 900px) { .demo-heading.section-heading { grid-template-columns: 1fr; gap: .8rem; } }
  .demo-tabs { display: block; margin-top: 2.5rem; border: 1px solid var(--border-strong); background: var(--surface-panel); box-shadow: var(--shadow-window); }
  .demo-tabs-list { display: flex; gap: .25rem; padding: .45rem; border-bottom: 1px solid var(--border-muted); background: var(--surface-app); }
  .demo-tabs-trigger, .demo-actions proto-ui-base-button, proto-ui-base-dialog-trigger, proto-ui-base-dialog-close { display: inline-flex; align-items: center; justify-content: center; min-height: 2.2rem; padding: .45rem .8rem; border: 1px solid transparent; cursor: pointer; font: 600 .76rem/1 var(--font-mono); letter-spacing: .04em; color: var(--text-secondary); }
  .demo-tabs-trigger[data-pui-selected], .demo-tabs-trigger[aria-selected="true"] { color: var(--text-primary); border-color: var(--border-strong); background: var(--surface-selected); }
  .demo-tab-panel { display: block; padding: 1rem; }
  .demo-tab-panel[hidden], .demo-tab-panel[data-pui-hidden="true"] { display: none; }
  .demo-controls { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .demo-controls label { display: grid; gap: .35rem; color: var(--text-muted); font: 600 .68rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .demo-select { position: relative; display: block; min-width: 15rem; }
  .demo-actions { display: flex; align-items: center; gap: .5rem; }
  .demo-actions proto-ui-base-button, proto-ui-base-dialog-trigger { border-color: var(--border-strong); color: var(--text-primary); background: var(--surface-app); }
  .gpui-frame { overflow: hidden; border: 1px solid var(--border-strong); background: #101215; }
  .frame-bar { display: flex; align-items: center; gap: .42rem; height: 2rem; padding: 0 .7rem; color: #858a92; background: #202328; font: .68rem/1 var(--font-mono); }
  .frame-bar span { width: .58rem; height: .58rem; border-radius: 50%; background: #50565f; }
  .frame-bar span:first-child { background: #c96c5b; }
  .frame-bar span:nth-child(2) { background: #c7a363; }
  .frame-bar span:nth-child(3) { background: #6f9672; }
  .frame-bar b { margin-left: .5rem; font-weight: 400; }
  .gpui-frame iframe { display: block; width: 100%; height: clamp(430px, 62vw, 610px); border: 0; background: #101215; }
  .demo-dialog { position: fixed; z-index: 81; top: 50%; left: 50%; width: min(34rem, calc(100vw - 2rem)); transform: translate(-50%, -50%); padding: 1.5rem; border: 1px solid var(--border-strong); background: var(--surface-elevated); box-shadow: var(--shadow-window); }
  proto-ui-base-dialog-title { display: block; font-size: 1.3rem; font-weight: 700; }
  proto-ui-base-dialog-description { display: block; margin: .85rem 0 1.25rem; color: var(--text-secondary); line-height: 1.6; }
  proto-ui-base-dialog-close { border-color: var(--border-strong); color: var(--text-primary); background: var(--surface-app); }
  .contract-panel { min-height: 430px; padding: clamp(1.5rem, 5vw, 4rem); }
  .contract-panel > p:nth-child(2) { max-width: 66ch; margin: 1rem 0 2rem; color: var(--text-secondary); font-size: 1.1rem; line-height: 1.65; }
  .contract-panel pre { overflow: auto; padding: 1.25rem; border: 1px solid var(--border-muted); background: var(--surface-app); color: var(--accent-amber); font: .78rem/1.8 var(--font-mono); }
  @media (max-width: 720px) {
    .demo-controls { align-items: stretch; flex-direction: column; }
    .demo-actions { flex-wrap: wrap; }
    .demo-select { min-width: 100%; }
    .gpui-frame iframe { height: 470px; }
  }
</style>
