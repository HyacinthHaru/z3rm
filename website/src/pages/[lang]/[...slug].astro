---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

type Props = { entry: CollectionEntry<"docs">; lang: "en" | "zh"; pairedPath: string };

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => {
    const [lang, ...parts] = entry.id.split("/");
    const routeParts = parts.at(-1) === "index" ? parts.slice(0, -1) : parts;
    const otherLang = lang === "en" ? "zh" : "en";
    const pair = entries.find((candidate) =>
      candidate.data.translationKey === entry.data.translationKey && candidate.id.startsWith(`${otherLang}/`)
    );
    const pairParts = pair?.id.split("/").slice(1) ?? routeParts;
    const pairedRoute = pairParts.at(-1) === "index" ? pairParts.slice(0, -1) : pairParts;
    return {
      params: { lang, slug: routeParts.length ? routeParts.join("/") : undefined },
      props: { entry, lang, pairedPath: `/${otherLang}/${pairedRoute.join("/")}` },
    };
  });
}

const { entry, lang, pairedPath } = Astro.props;
const { Content, headings } = await render(entry);
const entries = (await getCollection("docs")).filter((candidate) => candidate.id.startsWith(`${lang}/`));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(`${base}/${lang}/${Astro.params.slug ? `${Astro.params.slug}/` : ""}`, Astro.site);
const alternate = new URL(`${base}${pairedPath}${pairedPath.endsWith("/") ? "" : "/"}`, Astro.site);
const isHome = entry.data.section === "home";
---
{isHome ? (
  <SiteLayout title={entry.data.title} description={entry.data.description} {lang} {pairedPath} {canonical} {alternate}>
    <main id="content" class="temporary-home"><Content /></main>
  </SiteLayout>
) : (
  <DocsLayout {entry} {entries} {headings} {lang} {pairedPath} {canonical} {alternate}>
    <Content />
  </DocsLayout>
)}

<style>
  .temporary-home { width: min(calc(100% - 2rem), var(--page-width)); min-height: 70vh; margin: 6rem auto; }
</style>
