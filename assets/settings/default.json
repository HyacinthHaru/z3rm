{
  // z3rm 默认设置
  // 终端/多路复用器/UI chrome 设置

  // === 项目设置 (ProjectSettingsContent - flattened) ===
  "excluded_paths": ["node_modules", ".git"],
  "scan_symlinks": "local_only",

  "all_languages": {
    "defaults": {
      "word_diff_enabled": true
    }
  },

  // === 扩展设置 (ExtensionSettingsContent - flattened) ===
  "extension": {
    "directory": "~/.config/z3rm/extensions",
    "auto_sync_to_remote": true
  },

  // === 工作区设置 (WorkspaceSettingsContent - flattened) ===
  "window_decorations": "client",
  "text_rendering_mode": "platform_default",
  "focus_follows_mouse": { "enabled": false },
  "confirm_quit": false,
  "on_last_window_closed": "nothing",

  // === 远程设置 (RemoteSettingsContent - flattened) ===
  "auto_install": true,

  // === Tab 栏设置 ===
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
    "show_tab_bar_buttons": true,
    "show_pinned_tabs_in_separate_row": false,
    "middle_click_to_close": true,
    "mouse_scroll_to_switch": true,
    "show_active_item": false,
    "show_close_button": "hover"
  },

  // === 标题栏设置 ===
  "title_bar": {
    "show_branch_status_icon": false,
    "show_onboarding_banner": true,
    "show_user_picture": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_sign_in": true,
    "show_user_menu": true
  },

  // === 状态栏设置 ===
  "status_bar": {
    "stack_size": false,
    "working_directory": true,
    "session_status": false,
    "active_language_button": true,
    "active_encoding_button": "non_utf8",
    "cursor_position_button": true,
    "line_endings_button": false
  },

  // === 终端设置 ===
  "terminal": {
    "shell": "system",
    "working_directory": "current_project_directory",
    "env": {},
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default",
        "conda_manager": "auto"
      }
    },
    "font_weight": 400,
    "line_height": "standard",
    "cursor_shape": "block",
    "blinking": "terminal_controlled",
    "alternate_scroll": "on",
    "option_as_meta": false,
    "copy_on_select": false,
    "keep_selection_on_copy": true,
    "open_links_in_mouse_mode": true,
    "button": true,
    "dock": "bottom",
    "flexible": true,
    "default_width": 640,
    "default_height": 320,
    "max_scroll_history_lines": 10000,
    "scroll_multiplier": 1.0,
    "toolbar": {
      "breadcrumbs": false
    },
    "scrollbar": {
      "show": null
    },
    "minimum_contrast": 45,
    "path_hyperlink_regexes": [
      "File \"(?<path>[^\"]+)\", line (?<line>[0-9]+)",
      [
        "(?x)",
        "(?<path>",
        "    (",
        "        [^({\\[<\"'`\\ \\u2500-\\u257F]",
        "        ([^\\ :(]|[:(][^0-9()\\ ])*",
        "        [^()}\\]>\"'`.,;:\\ ]",
        "    |",
        "        [^(){}\\[\\]<>\"'`.,;:\\ \\u2500-\\u257F]",
        "    )",
        "    (:+[0-9]+(:[0-9]+)?|:?\\([0-9]+([,:]?[0-9]+)?\\))?",
        ")"
      ]
    ],
    "path_hyperlink_timeout_ms": 1,
    "show_count_badge": false,
    "bell": "off"
  },

  // === 多路复用器设置 ===
  "mux": {
    "keep_alive": true,
    "tabbar_style": "top",
    "scroll_mode": "per_client"
  },

  // === 影子快照设置 ===
  "shadow_snapshot": {
    "enabled": true,
    "quota_mode": "per_project",
    "per_project_quota_mb": 500,
    "ignore_patterns": [],
    "binary_detection": true,
    "debounce_ms": 500,
    "frequency_circuit_breaker_k": 10,
    "git_commit_hook": "clear"
  },

  // === 鼠标隐藏模式 ===
  "hide_mouse": "on_typing",

  // === Vim 模式 ===
  "vim_mode": false,

  // === 行号指示器格式 ===
  "line_indicator_format": "short"
}
