// §16.7 Mux tmux keymap profile: prefix key (Ctrl-b) + prefix-mode bindings
// spec §16.7, Plan 17 — tmux-compatible subset (~80% of common operations)
// NOTE: This is NOT 1:1 tmux compatibility; it covers the most common operations.
[
  // Normal mode: prefix key triggers prefix mode with 500ms timeout
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-b": ["mux::EnterPrefixMode", { "timeout_ms": 500 }],
      // Native lifecycle controls remain available even if prefix/QuickJS fails.
      "ctrl-alt-a": "mux::Attach",
      "ctrl-alt-k": "mux::KillSession",
      "ctrl-alt-q": "mux::KillServer",

      // §12 复制模式 (Plan 31)
      "ctrl-shift-;": "terminal::EnterCopyMode"
    }
  },
  // Prefix mode: after Ctrl-b, the next key is matched here
  {
    "context": "Terminal && PrefixMode",
    "bindings": {
      // Tab management
      "c": "mux_pane::NewTab",
      "&": "mux_pane::CloseTab",
      "n": "mux_pane::NextTab",
      "p": "mux_pane::PrevTab",

      // Pane splitting
      "%": "mux_pane::SplitRight",
      "\"": "mux_pane::SplitDown",

      // Pane navigation (directional)
      "left": "mux_pane::FocusLeft",
      "right": "mux_pane::FocusRight",
      "up": "mux_pane::FocusUp",
      "down": "mux_pane::FocusDown",
      "h": "mux_pane::FocusLeft",
      "j": "mux_pane::FocusDown",
      "k": "mux_pane::FocusUp",
      "l": "mux_pane::FocusRight",
      "o": "mux_pane::FocusNextPane",

      // Pane navigation (numbered)
      "0": "mux_pane::FocusPane0",
      "1": "mux_pane::FocusPane1",
      "2": "mux_pane::FocusPane2",
      "3": "mux_pane::FocusPane3",
      "4": "mux_pane::FocusPane4",
      "5": "mux_pane::FocusPane5",
      "6": "mux_pane::FocusPane6",
      "7": "mux_pane::FocusPane7",
      "8": "mux_pane::FocusPane8",

      // Pane resizing
      "ctrl-left": "mux_pane::ResizeLeft",
      "ctrl-right": "mux_pane::ResizeRight",
      "ctrl-up": "mux_pane::ResizeUp",
      "ctrl-down": "mux_pane::ResizeDown",

      // Pane zoom
      "z": "mux_pane::ZoomToggle",

      // Mux session
      "d": "mux::Detach",

      // Send literal Ctrl-b to PTY (double-tap escape)
      "ctrl-b": ["terminal::SendLiteral", { "keystroke": "C-b" }]
    }
  }
]
