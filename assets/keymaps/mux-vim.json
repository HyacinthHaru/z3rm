// §16.7 Mux vim keymap profile: vim-style pane navigation with hjkl
// spec §16.7, Plan 17 — vim-compatible pane movement
// Uses Ctrl-w prefix for pane operations (vim terminal convention)
[
  // Normal mode: Ctrl-w enters pane command mode
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-w": ["mux::EnterPrefixMode", { "timeout_ms": 500 }],

      // §12 复制模式 (Plan 31)
      "ctrl-shift-;": "terminal::EnterCopyMode"
    }
  },
  // Prefix mode: after Ctrl-w, hjkl for pane navigation
  {
    "context": "Terminal && PrefixMode",
    "bindings": {
      // Pane navigation (vim hjkl)
      "h": "mux_pane::FocusLeft",
      "j": "mux_pane::FocusDown",
      "k": "mux_pane::FocusUp",
      "l": "mux_pane::FocusRight",

      // Pane splitting (vim-style)
      "_": "mux_pane::SplitDown",
      "|": "mux_pane::SplitRight",

      // Pane management
      "n": "mux_pane::NewTab",
      "c": "mux_pane::CloseTab",
      "z": "mux_pane::ZoomToggle",
      "=": "mux_pane::ResizeEqual",
      "x": "mux_pane::CloseTab",

      // Tab navigation
      "gt": "mux_pane::NextTab",
      "gb": "mux_pane::PrevTab",

      // Pane switching by number
      "1": "mux_pane::FocusPane0",
      "2": "mux_pane::FocusPane1",
      "3": "mux_pane::FocusPane2",
      "4": "mux_pane::FocusPane3",
      "5": "mux_pane::FocusPane4",
      "6": "mux_pane::FocusPane5",
      "7": "mux_pane::FocusPane6",
      "8": "mux_pane::FocusPane7",
      "9": "mux_pane::FocusPane8",

      // Mux session
      "d": "mux::Detach",

      // Pane ordering
      "w": "mux_pane::FocusNextPane",
      "W": "mux_pane::FocusPrevPane",

      // Send literal Ctrl-w to PTY (double-tap escape)
      "ctrl-w": "terminal::sendKeystroke Ctrl-w"
    }
  }
]
