#!/usr/bin/env bash
# Compare the workspace test failures against the known-failing baseline by
# NAME, not by count.
#
# A matching count is not a matching set: the mux e2e suites alternate between
# passing and failing under a loaded parallel run, so a real regression can slip
# in while the total stays the same. This is exactly how a picker layout
# regression went unnoticed for eleven rounds of accessibility work.
#
# Usage: script/check-a11y-regressions [--a11y]
#   --a11y  run with accessibility active, which exercises code paths nothing
#           else does (see crates/gpui/src/window/a11y.rs).
set -uo pipefail

BASELINE_FILE="$(dirname "$0")/a11y-regression-baseline.txt"

if [[ "${1:-}" == "--a11y" ]]; then
    export Z3RM_A11Y_BUILD_HEADLESS=1
fi

# The re-run below compiles again, so it reports on whatever the tree looks
# like then rather than on what actually failed. Editing during a run turns a
# real regression into a reassuring "passes alone".
tree_before=$(git status --porcelain=v1; git rev-parse HEAD)

output=$(cargo test --workspace --features gpui_platform/runtime_shaders --no-fail-fast 2>&1)

# A crate whose tests do not compile runs none of them, and contributes no
# failing test names — so without this it looks exactly like a clean crate.
if printf '%s\n' "$output" | grep -qE '^error(\[E[0-9]+\])?: |^error: could not compile'; then
    echo "Some tests did not compile, so their results are missing entirely:"
    printf '%s\n' "$output" | grep -E '^error(\[E[0-9]+\])?: |^error: could not compile' | sort -u | head -20
    exit 1
fi
failures=$(printf '%s\n' "$output" | grep -E '^    [a-z_]+' | sed 's/^ *//' | sort -u)

baseline=$(grep -vE '^\s*(#|$)' "$BASELINE_FILE" | sort -u)

new=$(comm -13 <(printf '%s\n' "$baseline") <(printf '%s\n' "$failures"))
fixed=$(comm -23 <(printf '%s\n' "$baseline") <(printf '%s\n' "$failures"))

if [[ -n "$fixed" ]]; then
    echo "These baseline failures now pass; drop them from the baseline:"
    printf '  %s\n' $fixed
fi

if [[ -n "$new" && "$(git status --porcelain=v1; git rev-parse HEAD)" != "$tree_before" ]]; then
    echo "The working tree changed while the suite ran, so these failures cannot"
    echo "be re-checked against the code that produced them:"
    printf '  %s\n' $new
    exit 1
fi

if [[ -n "$new" ]]; then
    # The mux suites spawn real servers and sockets and go flaky under a loaded
    # parallel run, so a first failure is a candidate, not a verdict. Re-run
    # each one on its own before calling it a regression.
    confirmed=()
    for name in $new; do
        if cargo test --workspace --features gpui_platform/runtime_shaders \
            -- --exact "$name" >/dev/null 2>&1; then
            echo "Flaky under load, passes alone: $name"
        else
            confirmed+=("$name")
        fi
    done

    if [[ ${#confirmed[@]} -gt 0 ]]; then
        echo "New failures not in the baseline:"
        printf '  %s\n' "${confirmed[@]}"
        exit 1
    fi
fi

echo "No new failures."
