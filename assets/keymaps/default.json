// §16.7 Mux default keymap profile: global shortcuts without prefix key
// spec §16.7, Plan 17 — default profile uses Ctrl+Shift modifiers
[
  {
    "context": "Terminal",
    "bindings": {
      // Tab management
      "ctrl-shift-t": "mux_pane::NewTab",
      "ctrl-shift-w": "mux_pane::CloseTab",

      // Pane splitting
      "ctrl-shift-%": "mux_pane::SplitRight",
      "ctrl-shift-\"": "mux_pane::SplitDown",

      // Pane navigation
      "ctrl-shift-left": "mux_pane::FocusLeft",
      "ctrl-shift-right": "mux_pane::FocusRight",
      "ctrl-shift-up": "mux_pane::FocusUp",
      "ctrl-shift-down": "mux_pane::FocusDown",
      "ctrl-shift-n": "mux_pane::FocusNextPane",
      "ctrl-shift-p": "mux_pane::FocusPrevPane",

      // Pane switching by number (1-9)
      "ctrl-shift-1": "mux_pane::FocusPane0",
      "ctrl-shift-2": "mux_pane::FocusPane1",
      "ctrl-shift-3": "mux_pane::FocusPane2",
      "ctrl-shift-4": "mux_pane::FocusPane3",
      "ctrl-shift-5": "mux_pane::FocusPane4",
      "ctrl-shift-6": "mux_pane::FocusPane5",
      "ctrl-shift-7": "mux_pane::FocusPane6",
      "ctrl-shift-8": "mux_pane::FocusPane7",
      "ctrl-shift-9": "mux_pane::FocusPane8",

      // Tab switching
      "ctrl-alt-right": "mux_pane::NextTab",
      "ctrl-alt-left": "mux_pane::PrevTab",

      // Mux session
      "ctrl-alt-a": "mux::Attach",
      "ctrl-shift-d": "mux::Detach",
      "ctrl-alt-r": "mux::Reconnect",
      // §3.3 second window on the same session (Plan 32); ctrl-shift-n is NextTab
      "ctrl-alt-n": "mux::NewWindow",
      // §16.6 remote session window without leaving the GUI
      "ctrl-alt-o": "mux::OpenRemote",
      "ctrl-alt-k": "mux::KillSession",
      "ctrl-alt-q": "mux::KillServer",

      // Pane resizing
      "ctrl-shift-h": "mux_pane::ResizeLeft",
      "ctrl-shift-l": "mux_pane::ResizeRight",
      "ctrl-shift-k": "mux_pane::ResizeUp",
      "ctrl-shift-j": "mux_pane::ResizeDown",

      // Pane zoom
      "ctrl-shift-z": "mux_pane::ZoomToggle",

      // §3.3 Jump between OSC 133 command prompts
      "ctrl-shift-[": "mux_pane::JumpToPreviousPrompt",
      "ctrl-shift-]": "mux_pane::JumpToNextPrompt",

      // §16.6 Session clipboard, shared by every attached client
      "ctrl-alt-c": "mux_pane::CopyToSession",
      "ctrl-alt-v": "mux_pane::PasteFromSession",

      // §3.10 Rename the current session
      "ctrl-alt-comma": "mux::RenameSession",

      // Debug accessibility tree
      "ctrl-shift-a": "z3rm_debug::DumpAccessibilityTree",

      // §12 复制模式 (Plan 31)
      "ctrl-shift-;": "terminal::EnterCopyMode"
    }
  }
]
