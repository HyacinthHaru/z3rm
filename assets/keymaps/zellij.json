// §16.7 Mux zellij keymap profile: Alt-prefix style bindings
// spec §16.7, Plan 17 — zellij-compatible subset
// NOTE: zellij uses Alt+key bindings directly (no separate prefix key)
[
  {
    "context": "Terminal",
    "bindings": {
      // Tab management
      "alt-shift-t": "mux_pane::NewTab",
      "alt-shift-w": "mux_pane::CloseTab",
      "alt-n": "mux_pane::NextTab",
      "alt-p": "mux_pane::PrevTab",

      // Pane splitting
      "alt-+": "mux_pane::SplitRight",
      "alt-shift-+": "mux_pane::SplitDown",

      // Pane navigation (directional)
      "alt-left": "mux_pane::FocusLeft",
      "alt-right": "mux_pane::FocusRight",
      "alt-up": "mux_pane::FocusUp",
      "alt-down": "mux_pane::FocusDown",

      // Pane navigation (zellij hjkl)
      "alt-h": "mux_pane::FocusLeft",
      "alt-j": "mux_pane::FocusDown",
      "alt-k": "mux_pane::FocusUp",
      "alt-l": "mux_pane::FocusRight",
      "alt-w": "mux_pane::FocusNextPane",

      // Pane switching by number (zellij style)
      "alt-1": "mux_pane::FocusPane0",
      "alt-2": "mux_pane::FocusPane1",
      "alt-3": "mux_pane::FocusPane2",
      "alt-4": "mux_pane::FocusPane3",
      "alt-5": "mux_pane::FocusPane4",
      "alt-6": "mux_pane::FocusPane5",
      "alt-7": "mux_pane::FocusPane6",
      "alt-8": "mux_pane::FocusPane7",
      "alt-9": "mux_pane::FocusPane8",

      // Pane zoom
      "alt-z": "mux_pane::ZoomToggle",

      // Pane resizing (zellij style)
      "alt-shift-left": "mux_pane::ResizeLeft",
      "alt-shift-right": "mux_pane::ResizeRight",
      "alt-shift-up": "mux_pane::ResizeUp",
      "alt-shift-down": "mux_pane::ResizeDown",

      // Mux session
      "alt-d": "mux::Detach",
      // §3.3 second window on the same session (Plan 32); alt-n is NextTab
      "ctrl-alt-n": "mux::NewWindow",

      // §12 复制模式 (Plan 31)
      "ctrl-shift-;": "terminal::EnterCopyMode"
    }
  }
]
