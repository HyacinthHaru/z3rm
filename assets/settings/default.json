{
  // z3rm 默认设置
  // 终端/多路复用器/UI chrome 设置

  // === 项目设置 (ProjectSettingsContent - flattened) ===
  "excluded_paths": ["node_modules", ".git"],
  "scan_symlinks": "local_only",
  // Files whose contents must never leave the machine.
  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/*.cert",
    "**/*.crt",
    "**/secrets.yml"
  ],
  "hidden_files": ["**/.*"],
  "read_only_files": [],
  "file_scan_inclusions": [".env*"],

  "all_languages": {
    "defaults": {
      "word_diff_enabled": true
    }
  },

  // === 扩展设置 (ExtensionSettingsContent) ===
  "extension": {
    "directory": "~/.config/z3rm/extensions",
    "auto_sync_to_remote": true,
    "auto_install_extensions": {},
    "auto_update_extensions": {},
    "granted_capabilities": [
      {
        "kind": "process:exec",
        "command": "*",
        "args": ["**"]
      },
      {
        "kind": "download_file",
        "host": "*",
        "path": ["**"]
      },
      {
        "kind": "npm:install",
        "package": "*"
      }
    ]
  },

  // === 工作区设置 (WorkspaceSettingsContent - flattened) ===
  "window_decorations": "client",
  "text_rendering_mode": "platform_default",
  "focus_follows_mouse": { "enabled": false },
  "confirm_quit": false,
  "on_last_window_closed": "nothing",

  // === 远程设置 (RemoteSettingsContent - flattened) ===
  "auto_install": true,

  // === Tab 栏设置 ===
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
    "show_tab_bar_buttons": true,
    "show_pinned_tabs_in_separate_row": false,
    "middle_click_to_close": true,
    "mouse_scroll_to_switch": true,
    "show_active_item": false,
    "show_close_button": "hover"
  },

  // === 单个 Tab 项设置 ===
  "tabs": {
    "git_status": true,
    "close_position": "right",
    "activate_on_close": "next",
    "file_icons": true,
    "show_diagnostics": "off",
    "show_close_button": "hover"
  },

  // === 预览 Tab 设置 ===
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_project_panel": true,
    "enable_preview_from_file_finder": true,
    "enable_preview_from_multibuffer": true,
    "enable_preview_multibuffer_from_code_navigation": true,
    "enable_preview_file_from_code_navigation": true,
    "enable_keep_preview_on_code_navigation": false
  },

  // === Which-key 弹窗设置 ===
  "which_key": {
    "enabled": false,
    "delay_ms": 1000
  },

  // === 标题栏设置 ===
  "title_bar": {
    "show_branch_status_icon": false,
    "show_onboarding_banner": true,
    "show_user_picture": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_sign_in": true,
    "show_user_menu": true
  },

  // === 状态栏设置 ===
  "status_bar": {
    "stack_size": false,
    "working_directory": true,
    "session_status": false,
    "active_language_button": true,
    "active_encoding_button": "non_utf8",
    "cursor_position_button": true,
    "line_endings_button": false
  },

  // === 编辑器与搜索设置 ===
  "editor": {
    "cursor_blink": true,
    "cursor_shape": null,
    "current_line_highlight": "line",
    "selection_highlight": true,
    "rounded_selection": true,
    "lsp_highlight_debounce": 100,
    "hover_popover_enabled": true,
    "hover_popover_delay": 50,
    "hover_popover_sticky": true,
    "hover_popover_hiding_delay": 100,
    "toolbar": {
      "breadcrumbs": true,
      "quick_actions": true,
      "selections_menu": true,
      "agent_review": true,
      "code_actions": true
    },
    "scrollbar": {
      "show": "auto",
      "git_diff": true,
      "search_results": true,
      "selected_text": true,
      "selected_symbol": true,
      "diagnostics": "none",
      "cursors": true,
      "axes": {
        "horizontal": true,
        "vertical": true
      }
    },
    "minimap": {
      "show": "auto",
      "display_in": "active_editor",
      "thumb": "always",
      "thumb_border": "full",
      "current_line_highlight": null,
      "max_width_columns": 128
    },
    "gutter": {
      "min_line_number_digits": 2,
      "line_numbers": true,
      "runnables": true,
      "breakpoints": true,
      "bookmarks": true,
      "folds": true
    },
    "scroll_beyond_last_line": "one_page",
    "vertical_scroll_margin": 0.0,
    "autoscroll_on_clicks": true,
    "horizontal_scroll_margin": 0.0,
    "scroll_sensitivity": 1.0,
    "mouse_wheel_zoom": false,
    "fast_scroll_sensitivity": 2.0,
    "sticky_scroll": {
      "enabled": false
    },
    "relative_line_numbers": "disabled",
    "seed_search_query_from_cursor": "none",
    "use_smartcase_search": true,
    "multi_cursor_modifier": "alt",
    "redact_private_values": false,
    "expand_excerpt_lines": 3,
    "excerpt_context_lines": 2,
    "middle_click_paste": false,
    "double_click_in_multibuffer": "select",
    "search_wrap": true,
    "search": {
      "button": true,
      "whole_word": false,
      "case_sensitive": false,
      "include_ignored": false,
      "regex": false,
      "center_on_match": true
    },
    "auto_signature_help": true,
    "show_signature_help_after_edits": false,
    "go_to_definition_fallback": "lens",
    "go_to_definition_scroll_strategy": "center",
    "jupyter": {
      "enabled": true
    },
    "snippet_sort_order": "relevance",
    "diagnostics_max_severity": null,
    "inline_code_actions": false,
    "drag_and_drop_selection": {
      "enabled": true,
      "delay": 300
    },
    "code_lens": "on",
    "lsp_document_colors": "inlay",
    "lsp_document_links": true,
    "minimum_contrast_for_highlights": 0.15,
    "completion_menu_scrollbar": "auto",
    "completion_detail_alignment": "left",
    "completion_menu_item_kind": "all",
    "diff_view_style": "unified",
    "minimum_split_diff_width": 100.0
  },

  // === 项目面板设置 ===
  "project_panel": {
    // Whether to show the project panel button in the status bar.
    "button": true,
    // Whether to hide gitignored entries in the project panel.
    "hide_gitignore": false,
    // Default width (in pixels) of the project panel.
    "default_width": 240,
    // Where to dock the project panel. Can be "left" or "right".
    "dock": "left",
    // Spacing between entries. Can be "comfortable" or "standard".
    "entry_spacing": "comfortable",
    // Whether to show file icons in the project panel.
    "file_icons": true,
    // Whether to show folder icons or chevrons for directories.
    "folder_icons": true,
    // Whether to show the git status in the project panel.
    "git_status": true,
    // Amount of indentation (in pixels) for nested items.
    "indent_size": 20,
    // Settings related to indent guides in the project panel.
    "indent_guides": {
      // When to show indent guides. Can be "always" or "never".
      "show": "always"
    },
    // Whether to stick parent directories at the top of the project panel.
    "sticky_scroll": true,
    // Whether to reveal an entry automatically when the corresponding project
    // entry becomes active. Gitignored entries are never auto revealed.
    "auto_reveal_entries": true,
    // Whether to fold directories that contain only one directory.
    "auto_fold_dirs": true,
    // Whether to show folder names with bold text.
    "bold_folder_labels": false,
    // Whether the project panel should open on startup.
    "starts_open": true,
    // Scrollbar-related settings.
    "scrollbar": {
      // When to show the scrollbar in the project panel.
      // null inherits the editor scrollbar settings; otherwise one of
      // "auto", "system", "always", "never".
      "show": null,
      // Whether to allow horizontal scrolling. When false, the view is locked
      // to the leftmost position and long file names are clipped.
      "horizontal_scroll": true
    },
    // Which files containing diagnostics to mark in the project panel.
    // Can be "off", "errors" or "all".
    "show_diagnostics": "off",
    // Whether to hide the root entry when only one folder is open in the window.
    "hide_root": false,
    // Whether to hide the hidden entries in the project panel.
    "hide_hidden": false,
    // Whether to enable drag-and-drop operations in the project panel.
    "drag_and_drop": true,
    // Settings for automatically opening files.
    "auto_open": {
      // Whether to automatically open newly created files in the editor.
      "on_create": true,
      // Whether to automatically open files after pasting or duplicating them.
      "on_paste": true,
      // Whether to automatically open files dropped from external sources.
      "on_drop": true
    },
    // How to group sibling entries. Can be "directories_first", "mixed" or
    // "files_first".
    "sort_mode": "directories_first",
    // How to compare sibling entry names. Can be "default", "upper", "lower"
    // or "unicode".
    "sort_order": "default",
    // Whether to show error and warning count badges next to file names.
    "diagnostic_badges": false,
    // Whether to show a git status indicator next to file names.
    "git_status_indicator": false
  },

  // === 终端设置 ===
  "terminal": {
    "shell": "system",
    "working_directory": "current_project_directory",
    "env": {},
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default",
        "conda_manager": "auto"
      }
    },
    "font_weight": 400,
    "line_height": "standard",
    "cursor_shape": "block",
    "blinking": "terminal_controlled",
    "alternate_scroll": "on",
    "option_as_meta": false,
    "copy_on_select": false,
    "keep_selection_on_copy": true,
    "open_links_in_mouse_mode": true,
    "button": true,
    "dock": "bottom",
    "flexible": true,
    "default_width": 640,
    "default_height": 320,
    "max_scroll_history_lines": 10000,
    "scroll_multiplier": 1.0,
    "toolbar": {
      "breadcrumbs": false
    },
    "scrollbar": {
      "show": null
    },
    "minimum_contrast": 45,
    "path_hyperlink_regexes": [
      "File \"(?<path>[^\"]+)\", line (?<line>[0-9]+)",
      [
        "(?x)",
        "(?<path>",
        "    (",
        "        [^({\\[<\"'`\\ \\u2500-\\u257F]",
        "        ([^\\ :(]|[:(][^0-9()\\ ])*",
        "        [^()}\\]>\"'`.,;:\\ ]",
        "    |",
        "        [^(){}\\[\\]<>\"'`.,;:\\ \\u2500-\\u257F]",
        "    )",
        "    (:+[0-9]+(:[0-9]+)?|:?\\([0-9]+([,:]?[0-9]+)?\\))?",
        ")"
      ]
    ],
    "path_hyperlink_timeout_ms": 1,
    "show_count_badge": false,
    "bell": "off"
  },

  // === 多路复用器设置 ===
  "mux": {
    "keep_alive": true,
    "tabbar_style": "top",
    "scroll_mode": "per_client"
  },

  // === 影子快照设置 ===
  "shadow_snapshot": {
    "enabled": true,
    "quota_mode": "per_project",
    "per_project_quota_mb": 500,
    "ignore_patterns": [],
    "binary_detection": true,
    "debounce_ms": 500,
    "frequency_circuit_breaker_k": 10,
    "git_commit_hook": "clear"
  },

  // === 诊断设置 ===
  "diagnostics": {
    // Whether to show the project diagnostics button in the status bar.
    "button": true,
    // Whether to include warning-level diagnostics.
    "include_warnings": true,
    // Settings for pulling diagnostics from language servers.
    "lsp_pull_diagnostics": {
      "enabled": true,
      // Minimum time to wait before pulling; 0 turns the debounce off.
      "debounce_ms": 50
    },
    // Settings for showing inline diagnostics.
    "inline": {
      "enabled": false,
      // Time to wait after the last editor event before showing them.
      "update_debounce_ms": 150,
      // Padding, in columns, between the end of the source line and the diagnostic.
      "padding": 4,
      // Minimum column to display inline diagnostics at.
      "min_column": 0,
      // Highest severity to render inline; null follows the editor setting.
      "max_severity": null
    }
  },

  // === 文件查找器设置 ===
  "file_finder": {
    // Whether to show file icons in the file finder.
    "file_icons": false,
    // How much of the window width the file finder may take. One of
    // "small", "medium", "large", "x_large" or "full".
    "modal_max_width": "small",
    // Whether to skip focusing the active file when it is the first result.
    "skip_focus_for_active_in_search": false
  },

  // === 会话恢复设置 ===
  "session": {
    // Whether to restore unsaved buffers on restart.
    "restore_unsaved_buffers": true,
    // Whether to skip worktree trust checks.
    "trust_all_worktrees": false
  },

  // === 通用语言服务器设置 ===
  "global_lsp_settings": {
    "notifications": {
      // Timeout for auto-dismissing language server notifications; 0 disables it.
      "dismiss_timeout_ms": 5000
    }
  },

  // === direnv 加载方式 ===
  // One of "disabled", "direct" or "shell_hook".
  "load_direnv": "disabled",

  // === 鼠标隐藏模式 ===
  "hide_mouse": "on_typing",

  // === Vim 模式 ===
  "vim_mode": false,

  // === 行号指示器格式 ===
  "line_indicator_format": "short"
}
