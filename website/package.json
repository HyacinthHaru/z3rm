{
  "name": "z3rm-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && node --test tests/*.test.mjs",
    "build": "pnpm build:wasm && astro build",
    "build:wasm": "cd wasm/z3rm_demo && NO_COLOR=false trunk build --release",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual.spec.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.1",
    "@lifo-sh/core": "0.10.2",
    "@proto.ui/adapter-web-component": "0.2.0",
    "@proto.ui/core": "0.2.0",
    "@proto.ui/prototypes-base": "0.2.0",
    "astro": "6.3.1",
    "lifo-sh": "^0.10.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.3",
    "typescript": "5.9.2"
  }
}
