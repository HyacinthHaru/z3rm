---
import type { CollectionEntry } from "astro:content";
import DocsSidebar from "../components/DocsSidebar.astro";
import PageToc from "../components/PageToc.astro";
import SiteLayout from "./SiteLayout.astro";

type Heading = { depth: number; slug: string; text: string };
type Props = {
  entry: CollectionEntry<"docs">;
  entries: CollectionEntry<"docs">[];
  headings: Heading[];
  lang: "en" | "zh";
  pairedPath: string;
  canonical: URL;
  alternate: URL;
};
const { entry, entries, headings, lang, pairedPath, canonical, alternate } = Astro.props;
---
<SiteLayout title={entry.data.title} description={entry.data.description} {lang} {pairedPath} {canonical} {alternate}>
  <div class="docs-grid">
    <aside class="sidebar-column"><DocsSidebar {entries} {lang} currentId={entry.id} /></aside>
    <main id="content" class="docs-content">
      <div class="document-meta"><span>{entry.data.section}</span><span data-status={entry.data.status}>{entry.data.status}</span></div>
      <article><slot /></article>
    </main>
    <aside class="toc-column"><PageToc {headings} {lang} /></aside>
  </div>
</SiteLayout>
<style>
  .docs-grid { width: min(calc(100% - 2rem), 1380px); margin: 3rem auto 0; display: grid; grid-template-columns: 210px minmax(0, var(--text-width)) 190px; justify-content: center; gap: clamp(2rem, 5vw, 5rem); }
  .docs-content { min-width: 0; }
  .document-meta { display: flex; justify-content: space-between; margin-bottom: 1.5rem; color: var(--text-muted); font: 500 .68rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .document-meta [data-status="verified"] { color: var(--accent-green); }
  .document-meta [data-status="experimental"], .document-meta [data-status="mixed"] { color: var(--accent-amber); }
  article :global(h1) { margin: 0 0 1.5rem; font-size: clamp(2.6rem, 7vw, 4.8rem); }
  article :global(h2) { margin: 3.5rem 0 1rem; font-size: clamp(1.7rem, 4vw, 2.4rem); }
  article :global(h3) { margin: 2.2rem 0 .75rem; }
  article :global(p), article :global(li) { color: var(--text-secondary); }
  article :global(strong) { color: var(--text-primary); }
  article :global(blockquote) { margin: 2rem 0; padding: .2rem 0 .2rem 1.2rem; border-left: 2px solid var(--accent-blue); color: var(--text-secondary); }
  article :global(table) { width: 100%; border-collapse: collapse; font-size: .88rem; }
  article :global(th), article :global(td) { padding: .65rem .75rem; border: 1px solid var(--border-muted); text-align: left; vertical-align: top; }
  article :global(th) { background: var(--surface-panel); }
  .docs-content article pre { position: relative; }
  .docs-content article pre .code-copy { position: absolute; top: .5rem; right: .5rem; min-height: 1.8rem; padding: .25rem .6rem; border: 1px solid var(--border-muted); border-radius: var(--radius-control); color: var(--text-secondary); background: var(--surface-panel); cursor: pointer; font: 600 .68rem/1 var(--font-mono); opacity: 1; }
  .docs-content article pre:hover .code-copy { border-color: var(--border-strong); }
  .docs-content article pre .code-copy:active { background: var(--surface-selected); }
  @media (max-width: 1080px) { .docs-grid { grid-template-columns: 190px minmax(0, var(--text-width)); } .toc-column { display: none; } }
  @media (max-width: 760px) { .docs-grid { display: block; margin-top: 2rem; } .sidebar-column { display: none; } }
</style>

<script is:inline>
  // One-tap copy for docs code blocks: each pre gets a small copy button
  // with the same clipboard + live-region behavior as the landing's
  // install snippet, so following along never needs manual selection.
  const labels = {
    en: { copy: "Copy", done: "Copied" },
    zh: { copy: "复制", done: "已复制" },
  };
  const locale = document.documentElement.lang.startsWith("zh") ? "zh" : "en";
  const text = labels[locale];

  for (const pre of Array.from(document.querySelectorAll(".docs-content article pre"))) {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "code-copy";
    button.textContent = text.copy;
    button.setAttribute("aria-label", `${text.copy} — ${pre.textContent?.trim().slice(0, 40) ?? ""}`);
    pre.style.position = "relative";
    button.addEventListener("click", async () => {
      const source = pre.textContent?.replace(/\n$/, "") ?? "";
      window.__z3rmDocsCopied = source;
      try {
        await navigator.clipboard.writeText(source);
      } catch {
        const area = document.createElement("textarea");
        area.value = source;
        area.setAttribute("readonly", "");
        area.style.position = "fixed";
        area.style.opacity = "0";
        document.body.append(area);
        area.select();
        try {
          document.execCommand("copy");
        } catch {
          // Clipboard unavailable: nothing to clean up beyond the helper.
        }
        area.remove();
      }
      button.textContent = text.done;
      window.setTimeout(() => {
        button.textContent = text.copy;
      }, 1600);
    });
    pre.append(button);
  }
</script>
