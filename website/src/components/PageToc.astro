---
type Heading = { depth: number; slug: string; text: string };
type Props = { headings: Heading[]; lang: "en" | "zh" };
const { headings, lang } = Astro.props;
const visible = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
{visible.length > 1 && (
  <nav class="page-toc" aria-label={lang === "zh" ? "本页内容" : "On this page"}>
    <h2>{lang === "zh" ? "本页内容" : "On this page"}</h2>
    <ol>
      {visible.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
    </ol>
  </nav>
)}

<script>
  // Track which heading the reader is in and mirror it onto its TOC link as
  // `aria-current="location"` plus a visible marker, so a sticky TOC says
  // where you are instead of only where you could go.
  function watchCurrentSection(doc: Document) {
    const links = Array.from(doc.querySelectorAll<HTMLAnchorElement>(".page-toc a"));
    if (links.length === 0) return;
    const targets = links
      .map((link) => doc.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((heading): heading is HTMLElement => heading !== null);
    if (targets.length === 0) return;

    const mark = (current: Element | null) => {
      for (const link of links) {
        const isCurrent = current !== null && link.hash === `#${current.id}`;
        if (isCurrent) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    let visible: Element[] = [];
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            visible.push(entry.target);
          } else {
            visible = visible.filter((heading) => heading !== entry.target);
          }
        }
        const current = visible
          .slice()
          .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top)[0] ?? null;
        mark(current);
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    for (const heading of targets) observer.observe(heading);
  }

  watchCurrentSection(document);
</script>
<style>
  .page-toc { position: sticky; top: 5rem; padding-left: 1rem; border-left: 1px solid var(--border-muted); }
  .page-toc h2 { margin: 0 0 .65rem; color: var(--text-muted); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  .page-toc ol { list-style: none; margin: 0; padding: 0; }
  .page-toc li { margin: .4rem 0; font-size: .78rem; line-height: 1.3; }
  .page-toc li.nested { padding-left: .75rem; }
  .page-toc a { color: var(--text-secondary); text-decoration: none; }
  .page-toc a:hover { color: var(--text-primary); }
  .page-toc a[aria-current="location"] { color: var(--accent-blue); font-weight: 600; }
</style>
